# Server
PORT=3001
NODE_ENV=development
# Obligatorio en producción — genera uno con: openssl rand -hex 32
JWT_SECRET=change_me_super_secret

# CORS (déjalo vacío si el frontend se sirve desde el mismo servidor)
# CORS_ORIGIN=https://tudominio.com

# Postgres (docker-compose)
PGHOST=localhost
PGPORT=5435
PGUSER=agx
PGPASSWORD=agxpass
PGDATABASE=agx_health

# OpenAI (opcional — la app funciona sin esto)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
